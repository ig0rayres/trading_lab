# Names only — set values in EasyPanel or local env. Never commit secrets.

LIVE_TRADING_ENABLED=false

# Paper ledger Postgres (paper-gateway / webhook audit; not v4-scheduler)
LEDGER_DATABASE_URL=

# Gate A webhook (trading-lab-webhook) — prefer TV_WEBHOOK_TOKEN; TV_WEBHOOK_SECRET is legacy alias
TV_WEBHOOK_TOKEN=
TV_WEBHOOK_SECRET=
SIGNAL_COPY_SECRET=
USD_BRL_REFERENCE=

# Signed copy queue directory (optional override)
TV_QUEUE_DIR=/app/reports/webhooks/pending

# Alpaca paper (worker / paper-gateway only)
ALPACA_PAPER_TRADE=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional upstream pin in production
UPSTREAM_DIR=/app/vendor/day-trader-skill
UPSTREAM_COMMIT=

PAPER_RECONCILE_LEDGER_APPLY=false
DASHBOARD_BEARER_TOKEN=
# Cookie secret for trigger PATCH. Empty keeps those routes at 401. Does not arm an order.
DASHBOARD_OPERATOR_SESSION=
TRADING_LAB_KILL_SWITCH=

# G-MKT demo paths (names only — values in EasyPanel; never commit secrets)
DEMO_ACCOUNT_PATH_B3_EQUITY=
DEMO_ACCOUNT_PATH_FOREX=
CLEAR_SIM_BASE_URL=
CLEAR_SIM_API_KEY=
CLEAR_SIM_API_SECRET=
OANDA_PRACTICE_API_TOKEN=
OANDA_PRACTICE_ACCOUNT_ID=
