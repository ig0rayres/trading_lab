# MVP demo profile — names only. Copy to EasyPanel secrets; never commit real values.
# See docs/MVP-DEMO-RUNBOOK.md and docs/HOMOLOGATION.md § Feature 5.

LIVE_TRADING_ENABLED=false

# --- Both apps (webhook + worker) ---
LEDGER_DATABASE_URL=
USD_BRL_REFERENCE=5.0

# --- Webhook app (trading-lab-webhook) ---
TV_WEBHOOK_TOKEN=
SIGNAL_COPY_SECRET=
TV_QUEUE_DIR=/app/reports/webhooks/pending

# --- Worker app (trading-lab) — read-only Alpaca for Gate B unless submit test ---
ALPACA_PAPER_TRADE=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
TRADING_LAB_KILL_SWITCH=false

# Reconcile read-only (N9 item 5); not a fill proof
PAPER_RECONCILE_LEDGER_APPLY=false

# --- OFF by default (MVP smoke + daily ops). Turn ON only for N12.4 fill test ---
PAPER_SIGNAL_AUTO_ENABLED=false
PAPER_EXECUTION_ENABLED=false
