# Names only — set values in EasyPanel or local env. Never commit secrets.

LIVE_TRADING_ENABLED=false

# Paper ledger Postgres (paper-gateway only; not used by v4-scheduler)
LEDGER_DATABASE_URL=

# Webhook (trading-lab-webhook service)
TV_WEBHOOK_SECRET=

# Alpaca paper (paper-gateway only)
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=

# Optional upstream pin in production
UPSTREAM_DIR=/app/vendor/day-trader-skill
UPSTREAM_COMMIT=
